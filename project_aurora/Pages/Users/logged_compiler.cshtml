@page
@model project_aurora.Pages.compilerModel
@{
    ViewData["Title"] = "Compiler";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Community</title>
    <link href="~/css/compiler-style.css" rel="stylesheet">
    <link href="~/favicon.ico" rel="icon" type="image/x-icon/">
</head>
<body>
    <nav>
        <div class="links">
            <a asp-page="/Login">Profile</a>
            <a asp-page="/Compiler">Compiler</a>
            <a asp-page="/Index"><img src="~/images/navigation-logo.png" /></a>
            <a asp-page="/Challenges">Challenges</a>
            <a asp-page="/Community">Community</a>
        </div>
    </nav>

    
    <form method="post" id="compiler-form">
        <div class="language-menu">
            <label asp-for="LanguageId">Language:</label>
            <select asp-for="LanguageId">
                <option value="46">Bash</option>
                <option value="62">Java</option>
                <option value="51">C#</option>
            </select>
        </div>

        <textarea asp-for="SourceCode"
                  class="compiler-window"
                  placeholder="// Type your code here..."
                  spellcheck="false"></textarea>

        <div class="lower-menu">
            <div class="left-option-menu">
                <button type="submit" id="run-button">
                    <img src="/images/run-button.png" alt="Run code" />
                </button>

                <button type="button" id="notification-button">
                    <img src="/images/note-button.png" alt="Notifications" />
                </button>

                <button type="button" id="share-button">
                    <img src="/images/share-button.png" alt="Share code" />
                </button>
            </div>

            <textarea class="output-window"
                      readonly
                      placeholder="Output and errors appear here...">@Model.Output</textarea>
        </div>
    </form>
</body>
