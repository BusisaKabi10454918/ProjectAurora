@page
@model project_aurora.Pages.Admin.AdminModel
@{
	ViewData["Title"] = "Admin";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link href="~/css/dash-styles.css" rel="stylesheet">
    <link href="~/favicon.ico" rel="icon" type="image/x-icon/">
</head>
<body>
    <nav>
        <div class="links">
            <a asp-page="/Login">Profile</a>
            <a asp-page="/Compiler">Compiler</a>
            <a asp-page="/Index"><img src="~/images/navigation-logo.png" /></a>
            <a asp-page="/Challenges">Challenges</a>
            <a asp-page="/Community">Community</a>
        </div>
    </nav>

    <h1 class="page-heading">&lt;/Welcome Admin&gt;</h1>

    <div class="admin-menu">

        <button type="button" class="admin-button">
            Review Challenges
        </button>

        <button type="button" class="admin-button" id="createChallengeBtn">
            Create New Challenge
        </button>

        <button type="button" class="admin-button">
            Generate New Admin Code
        </button>

        <button type="button" class="logout-button">
            Log Out
        </button>

    </div>
    <div id="challengePopup" class="popup-overlay">
        <div class="popup-content">

            <h2>Create New Challenge</h2>

            <form method="post" asp-page-handler="CreateChallenge">

                <label for="Title">Challenge Title</label>
                <input type="text"
                       id="Title"
                       name="Title"
                       maxlength="150"
                       placeholder="Enter challenge title"
                       required />

                <label for="Description">Description</label>
                <textarea id="Description"
                          name="Description"
                          placeholder="Describe the challenge..."
                          required></textarea>

                <label for="Answer">Expected Answer</label>
                <textarea id="Answer"
                          name="Answer"
                          placeholder="Enter the expected solution..."
                          required></textarea>

                <label>Accepted Languages</label>

                <div class="language-options">
                    <label>
                        <input type="checkbox" name="AllowedLanguages" value="CSharp" />
                        C#
                    </label>

                    <label>
                        <input type="checkbox" name="AllowedLanguages" value="Java" />
                        Java
                    </label>

                    <label>
                        <input type="checkbox" name="AllowedLanguages" value="Bash" />
                        Bash
                    </label>

                    <label>
                        <input type="checkbox" name="AllowedLanguages" value="Python" />
                        Python
                    </label>
                </div>

                <div asp-validation-summary="All"></div>

                <div class="popup-buttons">
                    <button type="submit">Create Challenge</button>
                    <button type="button" id="cancelChallengeBtn">Cancel</button>
                </div>

            </form>
        </div>
    </div>

    <script src="~/js/admin-challenge.js"></script>
</body>
