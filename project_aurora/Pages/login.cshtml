@page
@model project_aurora.Pages.loginModel
@{
    ViewData["Title"] = "Login";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="~/css/log-reg-style.css" rel="stylesheet">
    <link href="~/favicon.ico" rel="icon" type="image/x-icon/">
</head>
<body>
    <nav>
        <div class="links">
            <a asp-page="/Login">Profile</a>
            <a asp-page="/Compiler">Compiler</a>
            <a asp-page="/Index"><img src="~/images/navigation-logo.png" /></a>
            <a asp-page="/Challenges">Challenges</a>
            <a asp-page="/Community">Community</a>
        </div>
    </nav>

    <div class="log-container">

        <script
            console.log("Viewport:", document.documentElement.clientWidth);
            console.log("Body:", document.body.scrollWidth);
            console.log("Login box:", document.querySelector(".log-container").getBoundingClientRect());
        ></script>

        <form method="post">

            <label for="credential">Email or Username:</label><br />
            <input type="text" placeholder="Please enter your email or username" id="credential" name="credential" /><br />

            <label for="password">Password:</label><br />
            <input type="password" placeholder="Please enter your password" id="password" name="password" /><br />

            <button type="submit">Login</button>

        </form>

        
    </div>

    <div id="error-validation" class="validation-popup">
        <div class="popup-content">
            <p id="error-message"></p>
            <button type="button" id="error-close">OK</button>
        </div>
    </div>

    <div id="success-validation" class="validation-popup">
        <div class="popup-content">
            <p id="success-message"></p>
            <button type="button" id="success-close">OK</button>
        </div>
    </div>

    <script src="~/js/page_validation.js"></script>

    <a id="reg-link" asp-page="/Register">Unregistered? Create an Account here!</a>
</body>
@if (!string.IsNullOrEmpty(Model.validationResult))
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const message = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(Model.validationResult)
                            );

            const isSuccess = message.includes("VER-REG-0000:");

            showPopup(message, isSuccess);
        });
    </script>
}