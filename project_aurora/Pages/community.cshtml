@page
@model project_aurora.Pages.communityModel
@{
    ViewData["Title"] = "Community";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Community</title>
    <link href="~/css/com-styles.css" rel="stylesheet">
    <link href="~/favicon.ico" rel="icon" type="image/x-icon/">
</head>
<body>
    <nav>
        <div class="links">
            <a asp-page="/Login">Profile</a>
            <a asp-page="/Compiler">Compiler</a>
            <a asp-page="/Index"><img src="~/images/navigation-logo.png" /></a>
            <a asp-page="/Challenges">Challenges</a>
            <a asp-page="/Community">Community</a>
        </div>
    </nav>

    <div class="community-layout">
        <div class="posts">

            @foreach (var post in Model.Posts)
            {
                <div class="question-stub">
                    <p class="question-name">
                        <a asp-page-handler="ViewPost"
                           asp-route-postID="@post.ID">
                            @(post.Poster?.Username ?? "Unknown User") Asks: @post.Title
                        </a>
                    </p>

                    <div class="lower-stub">
                        <div class="options-menu">

                            <div class="menu-option">
                                <img src="~/images/answers-icon.png" />
                                @post.Answers Answers
                            </div>

                            <div class="menu-option">
                                <form method="post" asp-page-handler="Vote" class="vote-form">
                                    <input type="hidden" name="postID" value="@post.ID" />

                                    <button type="submit" class="vote-button">
                                        <img src="~/images/votes-icon.png" />
                                    </button>
                                </form>

                                @post.Votes votes
                            </div>

                            <div class="menu-option">
                                <img src="~/images/views-icon.png" />
                                @post.Views Views
                            </div>

                        </div>

                        <p class="question-description">
                            @post.Description
                        </p>
                    </div>
                </div>
            }

        </div>

        <div class="community-sidebar">
            <button type="button" id="newPostBtn" class="new-post-btn">
                New Question
            </button>

            <div id="newPostPopup" class="popup-overlay">
                <div class="popup-content">
                    <h2>Create a Post</h2>

                    <form method="post" asp-page-handler="CreatePost">
                        <label for="NewPostTitle">Title</label>
                        <input type="text"
                               id="NewPostTitle"
                               name="NewPostTitle"
                               maxlength="150"
                               placeholder="Enter your post title"
                               required />

                        <label for="NewPostDescription">Description</label>
                        <textarea id="NewPostDescription"
                                  name="NewPostDescription"
                                  placeholder="What would you like to discuss?"
                                  required></textarea>

                        <div asp-validation-summary="All"></div>

                        <div class="popup-buttons">
                            <button type="submit">Publish</button>
                            <button type="button" id="cancelPostBtn">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>

    <script src="~/js/new-post.js"></script>
</body>