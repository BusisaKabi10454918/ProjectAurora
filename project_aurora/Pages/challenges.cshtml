@page
@model project_aurora.Pages.challengesModel
@{
    ViewData["Title"] = "Challenges";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Challenges</title>
    <link href="~/css/com-styles.css" rel="stylesheet">
    <link href="~/favicon.ico" rel="icon" type="image/x-icon/">
</head>
<body>
    <nav>
        <div class="links">
            <a asp-page="/Login">Profile</a>
            <a asp-page="/Compiler">Compiler</a>
            <a asp-page="/Index"><img src="~/images/navigation-logo.png" /></a>
            <a asp-page="/Challenges">Challenges</a>
            <a asp-page="/Community">Community</a>
        </div>
    </nav>
    @if (Model.Challenges.Count == 0)
    {
        <p>No challenges are currently available.</p>
    }
    @foreach (var challenge in Model.Challenges)
    {
        <div class="challenge-stub">

            <img src="~/images/challenge-icon.png" />

            <div class="challenge-content">

                <p class="challenge-name">
                    @challenge.Title
                </p>

                <div class="black-bar"></div>

                <p class="challenge-content">
                    @challenge.Description
                </p>

                <form method="post"
                      enctype="multipart/form-data"
                      asp-page-handler="SubmitChallenge">

                    <input type="hidden"
                           name="challengeID"
                           value="@challenge.ID" />

                    <input type="file"
                           name="submissionFile"
                           accept=".cs,.java,.sh,.py,.txt"
                           required />

                    <button type="submit" class="challenge-submit-btn">
                        Submit Challenge
                    </button>

                </form>
            </div>

        </div>
    }

</body>