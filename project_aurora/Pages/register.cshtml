@page
@model project_aurora.Pages.reigsterModel
@{
    ViewData["Title"] = "Register";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <link href="~/css/log-reg-style.css" rel="stylesheet">
    <link href="~/favicon.ico" rel="icon" type="image/x-icon/">
</head>
<body>
    <nav>
        <div class="links">
            <a asp-page="/Login">Profile</a>
            <a asp-page="/Compiler">Compiler</a>
            <a asp-page="/Index"><img src="~/images/navigation-logo.png" /></a>
            <a asp-page="/Challenges">Challenges</a>
            <a asp-page="/Community">Community</a>
        </div>
    </nav>

    <div class="reg-container">
        <form method="post">

            <label for="firstname">First Name:</label><br />
            <input type="text" placeholder="Please enter your first name" name="firstname" required /><br />

            <label for="lastname">Last Name:</label><br />
            <input type="text" placeholder="Please enter your last name" name="lastname" required /><br />

            <label for="email">Email:</label><br />
            <input type="email" placeholder="Please enter your email" name="email" required /><br />

            <label for="username">Username:</label><br />
            <input type="text" placeholder="Please enter a username" name="username" required /><br />

            <label for="password">Password:</label><br />
            <input type="password" placeholder="Please enter your password" name="password" required /><br />

            <label for="confirm-password">Confirm Password:</label><br />
            <input type="password" placeholder="Please confirm your password" name="confirm-password" required /><br />

            <label for="admin-code">Admin Code: (Please enter the admin code if you have one)</label><br />
            <input type="text" placeholder="Please enter the admin code" name="admin-code" /><br />

            <button type="submit">Register</button>
        </form>

    </div>

    <a id="log-link" asp-page="/login">Registered? Login here</a>
</body>